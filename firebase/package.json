{
  "name": "lumio-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-lumio",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-lumio \"vitest run --root rules-tests\"",
    "deploy:dev": "firebase deploy -P dev"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
