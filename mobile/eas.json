{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "dev", "EXPO_PUBLIC_USE_EMULATOR": "1" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_ENV": "dev" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_ENV": "prod" }
    }
  },
  "submit": { "production": {} }
}
